# Copy to .env and fill in. Everything here is optional: with no values set,
# the pipeline reads Network_Data/phisingData.csv, skips MLflow tracking and
# skips the S3 sync, so the whole thing runs offline.

# Data source. When unset, ingestion falls back to the bundled CSV.
MONGO_DB_URL=

# Experiment tracking. When unset, tracking is skipped (not an error).
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# S3 artifact sync. When unset, the sync step is skipped.
TRAINING_BUCKET_NAME=
AWS_REGION=ap-south-1

# Serving
PORT=8080
# Set in deployment: POST /train returns 401 without a matching X-API-Key header.
TRAIN_API_KEY=
# Comma-separated. When set, CORS credentials are enabled for these origins only.
ALLOWED_ORIGINS=
